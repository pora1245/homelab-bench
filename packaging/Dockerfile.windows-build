FROM rust:1.97.1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64-posix g++-mingw-w64-x86-64-posix && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-pc-windows-gnu
ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc
ENV CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc
ENV AR_x86_64_pc_windows_gnu=x86_64-w64-mingw32-ar
ENV RUSTFLAGS="-C target-feature=+crt-static --remap-path-prefix=/work=/llm-bench --remap-path-prefix=/usr/local/cargo=/cargo"
WORKDIR /work
CMD ["cargo", "build", "--release", "--locked", "--target", "x86_64-pc-windows-gnu"]
