{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Bench data pack v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "sources",
    "tasks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "description": "Source URL, revision, license and selection provenance."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "prompt",
        "answer",
        "scorer",
        "max_tokens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer": {},
        "scorer": {
          "enum": [
            "numeric",
            "choice",
            "exact",
            "json",
            "ifeval",
            "humaneval",
            "judge",
            "math",
            "mbpp",
            "livecodebench",
            "korean_rules",
            "experience",
            "bbh"
          ]
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "meta": {
          "description": "Scorer data only; never sent to target. judge requires rubric, IFEval requires key/instruction_id_list/kwargs, HumanEval requires test/entry_point."
        }
      }
    }
  }
}
